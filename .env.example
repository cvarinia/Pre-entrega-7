# Copia este archivo como .env y completa la clave del proveedor que uses.
# El archivo .env esta en .gitignore: nunca se sube al repositorio.

# Proveedor del LLM: "gemini" o "anthropic".
PROVEEDOR=anthropic

# --- Si PROVEEDOR=gemini ----------------------------------------------------
# Clave de Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=pega_aca_tu_clave

# --- Si PROVEEDOR=anthropic -------------------------------------------------
# Clave de la consola de API: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=pega_aca_tu_clave

# Modelo. Vacio = default de cada proveedor (gemini-3.6-flash / claude-haiku-4-5-20251001).
MODELO_LLM=

# 0 = respuestas deterministas, recomendado para agentes con tools.
TEMPERATURA=0

# Rondas maximas del Supervisor: condicion de parada contra el "Supervisor infinito".
MAX_RONDAS_SUPERVISOR=6

# Pasos internos maximos de cada especialista (su propio ciclo ReAct).
LIMITE_PASOS_ESPECIALISTA=12

# Techo global de pasos del grafo (red de seguridad de ultima instancia).
LIMITE_RECURSION_GRAFO=30

# Segundos maximos de espera por cada llamada al modelo.
TIMEOUT_MODELO=90

# --- PE7: API + worker ------------------------------------------------------
# Redis (cola de jobs, estado de los jobs y checkpoints del grafo).
# Corriendo la API y el worker en tu maquina: localhost. Dentro de Docker
# Compose se usa el nombre del servicio (redis://redis:6379/0).
REDIS_URL=redis://localhost:6379/0

# Cuantos jobs ejecuta el worker al mismo tiempo (la prueba de carga usa 5).
MAX_TRABAJOS_CONCURRENTES=5

# --- PE7: observabilidad (Arize Phoenix) -------------------------------------
# true = el worker manda trazas a Phoenix. false = funciona igual, sin trazas.
OBSERVABILIDAD=true
# A donde se mandan las trazas. Con Docker Compose, Phoenix escucha en el 6006.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# Nombre del proyecto en el dashboard (http://localhost:6006).
PHOENIX_PROJECT_NAME=orquestador-menus
